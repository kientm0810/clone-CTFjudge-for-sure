{$SITE_ADDRESS:http://localhost} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    handle_path /api/* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }
}
