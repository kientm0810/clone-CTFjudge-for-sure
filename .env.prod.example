APP_ENV=production
APP_SECRET_KEY=replace-with-a-long-random-secret

# Use http://SERVER_IP while testing. Replace with a domain to let Caddy enable HTTPS.
SITE_ADDRESS=http://YOUR_SERVER_IP
CORS_ORIGINS=http://YOUR_SERVER_IP
API_ROOT_PATH=/api

POSTGRES_DB=ctfjudge
POSTGRES_USER=ctfjudge
POSTGRES_PASSWORD=replace-with-a-strong-database-password

REDIS_URL=redis://redis:6379/0

DEFAULT_CHAT_MODEL=ollama/qwen2.5:3b
DEFAULT_EMBEDDING_MODEL=ollama/nomic-embed-text
DEFAULT_TEMPERATURE=0.1

# Only needed when Ollama is reachable from this server.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=180

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

UPLOAD_DIR=/data/uploads
ARTIFACT_DIR=/data/artifacts
